    const newRecord: SimTradeRecord = {
      id: `SNIPE-${Date.now()}`,
      windowLabel,
      entryTime: new Date().toLocaleTimeString(),
      side: m.targetSide,
      entryPriceCents: entryCents,
      betAmountUsd: betUsd,
      initialShares: shares,
      remainingShares: shares,
      strikePrice: activeStrike,
      entrySpotPrice: currentSpot,
      reversalScoreAtEntry: m.reversalScore,
      stage1Triggered: false,
      stage1PayoutUsd: 0,
      settlementPrice: null,
      finalPayoutUsd: 0,
      netPnL: -betUsd,
      status: 'HOLDING',
      notes: `⚡ 以 ${entryCents}¢ 狙击买入 ${shares} 份 ${m.targetSide} (${m.triggerReason})`,
    };

