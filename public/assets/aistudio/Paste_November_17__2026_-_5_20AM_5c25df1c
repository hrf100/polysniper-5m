import React, { useState, useEffect, useRef } from 'react';

// ==================== 数据结构定义 ====================
interface TradeTick {
  time: number;
  price: number;
  qty: number;
  isBuyerMaker: boolean; // false = Taker Buy, true = Taker Sell
}

interface Kline1m {
  time: number;
  open: number;
  high: number;
  low: number;
  close: number;
}

interface ChartPoint {
  elapsedSec: number;
  spot: number;
  chainlink: number;
  strike: number;
  upBid: number;   // 美分 (0-100)
  upAsk: number;   // 美分 (0-100)
  downBid: number; // 美分 (0-100)
  downAsk: number; // 美分 (0-100)
}

interface SniperMetrics {
  remainSec: number;
  targetSide: 'UP' | 'DOWN';
  targetAskCents: number;
  targetBidCents: number;
  dollarGap: number;          // Spot - Strike ($)
  oracleGap: number;          // Chainlink - Strike ($)
  atr1m: number;              // 1分钟平均波幅 ($)
  normalizedGapR: number;     // 标准化差值 R_gap
  tir5s: number;              // 5秒主动买卖失衡比 [-1, 1]
  tir30s: number;             // 30秒主动买卖失衡比 [-1, 1]
  bounceFromExtreme: number;  // 距本盘极值反弹幅度 ($)
  oracleCushionAdvantage: number; // Chainlink缓冲垫优势 ($)
  reversalScore: number;      // 综合翻转几率评分 (0-100)
  canSnipe: boolean;
  triggerReason: string;
}

interface SimTradeRecord {
  id: string;
  windowLabel: string;
  entryTime: string;
  side: 'UP' | 'DOWN';
  entryPriceCents: number;
  betAmountUsd: number;       // 固定 $5.00
  initialShares: number;
  remainingShares: number;
  strikePrice: number;
  entrySpotPrice: number;
  reversalScoreAtEntry: number;
  stage1Triggered: boolean;   // 是否已触发半仓翻倍抽本
  stage1PayoutUsd: number;    // 第一阶段收回的资金
  settlementPrice: number | null;
  finalPayoutUsd: number;
  netPnL: number;
  status: 'HOLDING' | 'STAGE1_FREEROLL' | 'WON_FULL' | 'LOSS_STOPPED' | 'FREEROLL_EXPIRED';
  notes: string;
}

interface WalletAuthState {
  eoaPrivateKey: string;
  eoaAddress: string;
  proxyWalletAddress: string;
  apiKey: string;
  apiSecret: string;
  apiPassphrase: string;
  usdcCashBalance: number;
  portfolioValue: number;
  maticBalance: number;
  authStatus: string;
  isLoading: boolean;
}

// 标准正态分布近似函数 (用于计算基础跨越概率与实时盘口定价兜底)
function normCDF(x: number): number {
  const t = 1 / (1 + 0.2316419 * Math.abs(x));
  const d = 0.3989423 * Math.exp((-x * x) / 2);
  const prob =
    d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
  return x > 0 ? 1 - prob : prob;
}

export default function PolymarketSub10SniperTerminal() {
  // ==================== 1. 钱包、L2 API Key 与资产状态 ====================
  const [showWalletModal, setShowWalletModal] = useState<boolean>(false);
  const [walletState, setWalletState] = useState<WalletAuthState>({
    eoaPrivateKey: '',
    eoaAddress: '',
    proxyWalletAddress: '',
    apiKey: '',
    apiSecret: '',
    apiPassphrase: '',
    usdcCashBalance: 0,
    portfolioValue: 0,
    maticBalance: 0,
    authStatus: '未连接钱包',
    isLoading: false,
  });

  // ==================== 2. 实时行情与 Polymarket 盘口状态 ====================
  const [wsStatus, setWsStatus] = useState({ chainlink: false, binance: false, polyClob: false });
  const [activeMarketTitle, setActiveMarketTitle] = useState<string>('BTC Up or Down (5m)');
  const [spotPrice, setSpotPrice] = useState<number>(0);
  const [chainlinkPrice, setChainlinkPrice] = useState<number>(0);
  const [strikePrice, setStrikePrice] = useState<number>(0);
  const [orderbook, setOrderbook] = useState({
    upBid: 49,
    upAsk: 51,
    downBid: 49,
    downAsk: 51,
    isLiveClob: false,
  });
  const [chartSeries, setChartSeries] = useState<ChartPoint[]>([]);

  // ==================== 3. 狙击策略参数与模拟账本状态 ====================
  const [autoSimEnabled, setAutoSimEnabled] = useState<boolean>(true);
  const [maxEntryCents, setMaxEntryCents] = useState<number>(10); // 默认 ≤10¢ 触发
  const [minReversalScore, setMinReversalScore] = useState<number>(62); // 默认翻转得分 ≥62 触发
  const [simVirtualBankroll, setSimVirtualBankroll] = useState<number>(100); // 默认模拟本金 $100 (每次$5)
  const [sniperMetrics, setSniperMetrics] = useState<SniperMetrics | null>(null);
  const [tradeLedger, setTradeLedger] = useState<SimTradeRecord[]>(() => {
    try {
      const saved = localStorage.getItem('poly_sub10_ledger_v1');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  });

  // 高频内存 Ref 缓冲池
  const tradesRef = useRef<TradeTick[]>([]);
  const klinesRef = useRef<Kline1m[]>([]);
  const basisWindowRef = useRef<number[]>([]);
  const pricesRef = useRef({
    spot: 0,
    chainlink: 0,
    strike: 0,
    windowStartSec: 0,
    windowHigh: 0,
    windowLow: Infinity,
  });
  const orderbookRef = useRef({ upBid: 49, upAsk: 51, downBid: 49, downAsk: 51, isLiveClob: false });
  const clobTokenIdsRef = useRef<{ upTokenId: string; downTokenId: string }>({ upTokenId: '', downTokenId: '' });
  const tradeLedgerRef = useRef<SimTradeRecord[]>(tradeLedger);

  useEffect(() => {
    tradeLedgerRef.current = tradeLedger;
    try {
      localStorage.setItem('poly_sub10_ledger_v1', JSON.stringify(tradeLedger));
    } catch {}
  }, [tradeLedger]);

  // ==================== 模块一：私钥登录 Polymarket、派生 API Key 与查询余额 ====================
  const connectAndAuthenticatePolymarket = async () => {
    if (!walletState.eoaPrivateKey.trim()) {
      alert('请输入有效的主钱包/中转钱包私钥 (0x开头)');
      return;
    }
    setWalletState((prev) => ({ ...prev, isLoading: true, authStatus: '正在加载加密组件并验证私钥...' }));

    try {
      // 动态加载 ethers v6 (免本地 npm 安装冲突)
      const ethers = await import('https://esm.sh/ethers@6.13.2');
      const pk = walletState.eoaPrivateKey.trim().startsWith('0x')
        ? walletState.eoaPrivateKey.trim()
        : `0x${walletState.eoaPrivateKey.trim()}`;
      const wallet = new ethers.Wallet(pk);
      const eoaAddr = wallet.address;

      // 1. 若用户未手动填写 Proxy 钱包地址，尝试通过 Polymarket Gamma Profile 查询绑定的代理钱包
      let targetProxyAddr = walletState.proxyWalletAddress.trim() || eoaAddr;
      try {
        const profRes = await fetch(`https://gamma-api.polymarket.com/public-profile?address=${eoaAddr}`);
        if (profRes.ok) {
          const profData = await profRes.json();
          if (profData?.proxyWallet) {
            targetProxyAddr = profData.proxyWallet;
          }
        }
      } catch {
        // 跨域或无代理钱包时默认使用 EOA 地址查询
      }

      // 2. 执行 EIP-712 L1 签名以派生 Polymarket CLOB L2 API Key
      const timestamp = Math.floor(Date.now() / 1000).toString();
      const nonce = 0;
      const domain = {
        name: 'ClobAuthDomain',
        version: '1',
        chainId: 137,
      };
      const types = {
        ClobAuth: [
          { name: 'address', type: 'address' },
          { name: 'timestamp', type: 'string' },
          { name: 'nonce', type: 'uint256' },
          { name: 'message', type: 'string' },
        ],
      };
      const value = {
        address: eoaAddr,
        timestamp,
        nonce,
        message: 'This message attests that I control the given wallet',
      };

      const sig = await wallet.signTypedData(domain, types, value);

      let derivedKey = '';
      let derivedSecret = '';
      let derivedPassphrase = '';
      let authNote = 'EIP-712 签名完成';

      try {
        const authHeaders = {
          POLY_ADDRESS: eoaAddr,
          POLY_SIGNATURE: sig,
          POLY_TIMESTAMP: timestamp,
          POLY_NONCE: nonce.toString(),
        };
        const deriveRes = await fetch('https://clob.polymarket.com/auth/derive-api-key', {
          method: 'GET',
          headers: authHeaders,
        });
        if (deriveRes.ok) {
          const creds = await deriveRes.json();
          derivedKey = creds.apiKey || '';
          derivedSecret = creds.secret || '';
          derivedPassphrase = creds.passphrase || '';
          authNote = '✅ L2 API Key 派生成功';
        } else {
          // 若尚未创建过，尝试 POST 创建
          const createRes = await fetch('https://clob.polymarket.com/auth/api-key', {
            method: 'POST',
            headers: authHeaders,
          });
          if (createRes.ok) {
            const creds = await createRes.json();
            derivedKey = creds.apiKey || '';
            derivedSecret = creds.secret || '';
            derivedPassphrase = creds.passphrase || '';
            authNote = '✅ L2 API Key 创建成功';
          } else {
            authNote = `⚠️ 签名有效 (${sig.slice(0, 10)}...)，CLOB 接口需代理访问`;
          }
        }
      } catch {
        authNote = `✅ 本地 EIP-712 签名就绪 (${sig.slice(0, 12)}...)`;
      }

      // 3. 查询 Polygon 链上真实 USDC.e 资金余额与 Polymarket 持仓组合余额
      await refreshWalletBalances(eoaAddr, targetProxyAddr, derivedKey, derivedSecret, derivedPassphrase, authNote);
    } catch (err: any) {
      setWalletState((prev) => ({
        ...prev,
        isLoading: false,
        authStatus: `❌ 私钥解析失败: ${err?.message || '格式错误'}`,
      }));
    }
  };

  const refreshWalletBalances = async (
    eoaAddr: string,
    proxyAddr: string,
    apiKey = walletState.apiKey,
    apiSecret = walletState.apiSecret,
    apiPassphrase = walletState.apiPassphrase,
    statusPrefix = walletState.authStatus
  ) => {
    const queryAddr = proxyAddr || eoaAddr;
    if (!queryAddr) return;

    try {
      const polygonRpc = 'https://polygon-rpc.com';
      const usdcContract = '0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174'; // Polygon USDC.e (Polymarket 结算资产)
      const paddedAddr = queryAddr.toLowerCase().replace('0x', '').padStart(64, '0');

      // 并发查询 USDC.e 余额、MATIC 余额与 Polymarket Data API 组合净值
      const [usdcRpcRes, maticRpcRes, polyValRes] = await Promise.allSettled([
        fetch(polygonRpc, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: '2.0',
            id: 1,
            method: 'eth_call',
            params: [{ to: usdcContract, data: `0x70a08231${paddedAddr}` }, 'latest'],
          }),
        }).then((r) => r.json()),
        fetch(polygonRpc, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: '2.0',
            id: 2,
            method: 'eth_getBalance',
            params: [eoaAddr, 'latest'],
          }),
        }).then((r) => r.json()),
        fetch(`https://data-api.polymarket.com/value?user=${queryAddr}`).then((r) => r.json()),
      ]);

      let usdcBal = 0;
      if (usdcRpcRes.status === 'fulfilled' && usdcRpcRes.value?.result) {
        usdcBal = parseInt(usdcRpcRes.value.result, 16) / 1e6;
      }

      let maticBal = 0;
      if (maticRpcRes.status === 'fulfilled' && maticRpcRes.value?.result) {
        maticBal = parseInt(maticRpcRes.value.result, 16) / 1e18;
      }

      let portVal = 0;
      if (polyValRes.status === 'fulfilled') {
        const valData = polyValRes.value;
        if (Array.isArray(valData) && valData.length > 0) {
          portVal = parseFloat(valData[0]?.value || 0);
        } else if (typeof valData?.value === 'number') {
          portVal = valData.value;
        }
      }

      setWalletState((prev) => ({
        ...prev,
        eoaAddress: eoaAddr,
        proxyWalletAddress: queryAddr,
        apiKey: apiKey || prev.apiKey,
        apiSecret: apiSecret || prev.apiSecret,
        apiPassphrase: apiPassphrase || prev.apiPassphrase,
        usdcCashBalance: Number(usdcBal.toFixed(2)),
        portfolioValue: Number(portVal.toFixed(2)),
        maticBalance: Number(maticBal.toFixed(4)),
        authStatus: statusPrefix,
        isLoading: false,
      }));
    } catch {
      setWalletState((prev) => ({ ...prev, isLoading: false }));
    }
  };

  // ==================== 模块二：连接真实数据流 (Chainlink + 币安 + Polymarket CLOB) ====================
  useEffect(() => {
    // 1. 拉取币安最近 25 根 1m K线用于计算真实 ATR 波幅
    fetch('https://data-api.binance.vision/api/v3/klines?symbol=BTCUSDT&interval=1m&limit=25')
      .then((r) => r.json())
      .then((data) => {
        if (Array.isArray(data)) {
          klinesRef.current = data.map((d: any) => ({
            time: d[0],
            open: parseFloat(d[1]),
            high: parseFloat(d[2]),
            low: parseFloat(d[3]),
            close: parseFloat(d[4]),
          }));
        }
      })
      .catch(() => {});

    // 2. 连接 Polymarket RTDS 获取官方 Chainlink BTC/USD 实时喂价
    const polyRtdsWs = new WebSocket('wss://ws-live-data.polymarket.com');
    polyRtdsWs.onopen = () => {
      setWsStatus((s) => ({ ...s, chainlink: true }));
      polyRtdsWs.send(
        JSON.stringify({
          action: 'subscribe',
          subscriptions: [{ topic: 'crypto_prices_chainlink', type: '*', filters: '{"symbol":"btc/usd"}' }],
        })
      );
    };
    polyRtdsWs.onmessage = (ev) => {
      try {
        const msg = JSON.parse(ev.data);
        const val = msg?.payload?.value || msg?.data?.price;
        if (val) {
          const p = parseFloat(val);
          pricesRef.current.chainlink = p;
          setChainlinkPrice(p);
          if (pricesRef.current.strike === 0) {
            pricesRef.current.strike = p;
            setStrikePrice(p);
          }
        }
      } catch {}
    };
    polyRtdsWs.onclose = () => setWsStatus((s) => ({ ...s, chainlink: false }));

    // 3. 连接 Binance 永续与现货实时成交流 + 1m K线流
    const binanceWs = new WebSocket(
      'wss://stream.binance.com:9443/stream?streams=btcusdt@aggTrade/btcusdt@kline_1m'
    );
    binanceWs.onopen = () => setWsStatus((s) => ({ ...s, binance: true }));
    binanceWs.onmessage = (ev) => {
      const msg = JSON.parse(ev.data);
      if (msg.stream === 'btcusdt@aggTrade') {
        const d = msg.data;
        const p = parseFloat(d.p);
        pricesRef.current.spot = p;
        setSpotPrice(p);

        // 更新本盘内最高/最低极值
        if (p > pricesRef.current.windowHigh) pricesRef.current.windowHigh = p;
        if (p < pricesRef.current.windowLow) pricesRef.current.windowLow = p;

        // 若 Chainlink 尚未返回首帧，用去偏后的现货价初始化
        if (pricesRef.current.chainlink === 0) {
          pricesRef.current.chainlink = p;
          setChainlinkPrice(p);
        }
        if (pricesRef.current.strike === 0) {
          pricesRef.current.strike = pricesRef.current.chainlink || p;
          setStrikePrice(pricesRef.current.strike);
        }

        tradesRef.current.push({
          time: d.T,
          price: p,
          qty: parseFloat(d.q),
          isBuyerMaker: d.m,
        });
      } else if (msg.stream === 'btcusdt@kline_1m') {
        const k = msg.data.k;
        const kline: Kline1m = {
          time: k.t,
          open: parseFloat(k.o),
          high: parseFloat(k.h),
          low: parseFloat(k.l),
          close: parseFloat(k.c),
        };
        const arr = klinesRef.current;
        if (arr.length > 0 && arr[arr.length - 1].time === kline.time) {
          arr[arr.length - 1] = kline;
        } else {
          arr.push(kline);
          if (arr.length > 40) arr.shift();
        }
      }
    };
    binanceWs.onclose = () => setWsStatus((s) => ({ ...s, binance: false }));

    return () => {
      polyRtdsWs.close();
      binanceWs.close();
    };
  }, []);

  // 自动同步当前 5 分钟周期的 Polymarket 盘口 Token ID 与真实 CLOB 买一/卖一价
  useEffect(() => {
    const syncPolymarket5mBook = async () => {
      const nowSec = Math.floor(Date.now() / 1000);
      const winStart = Math.floor(nowSec / 300) * 300;
      const slug = `btc-updown-5m-${winStart}`;

      // 尝试通过官方 slug 或 CORS 代理获取当前 5m 盘口的 clobTokenIds
      if (!clobTokenIdsRef.current.upTokenId || pricesRef.current.windowStartSec !== winStart) {
        const urls = [
          `https://gamma-api.polymarket.com/events?slug=${slug}`,
          `https://corsproxy.io/?${encodeURIComponent(`https://gamma-api.polymarket.com/events?slug=${slug}`)}`,
        ];
        for (const u of urls) {
          try {
            const res = await fetch(u);
            if (res.ok) {
              const evs = await res.json();
              const m = evs?.[0]?.markets?.[0];
              if (m?.clobTokenIds) {
                const ids = JSON.parse(m.clobTokenIds);
                if (ids.length >= 2) {
                  clobTokenIdsRef.current = { upTokenId: ids[0], downTokenId: ids[1] };
                  setActiveMarketTitle(m.question || `BTC Up or Down (${slug})`);
                  break;
                }
              }
            }
          } catch {}
        }
      }

      // 若已拿到 Token ID，拉取真实 CLOB 买一/卖一盘口
      const { upTokenId, downTokenId } = clobTokenIdsRef.current;
      if (upTokenId && downTokenId) {
        try {
          const [upRes, downRes] = await Promise.all([
            fetch(`https://clob.polymarket.com/book?token_id=${upTokenId}`),
            fetch(`https://clob.polymarket.com/book?token_id=${downTokenId}`),
          ]);
          if (upRes.ok && downRes.ok) {
            const upBook = await upRes.json();
            const downBook = await downRes.json();
            const upBid = upBook.bids?.length ? Math.round(parseFloat(upBook.bids[0].price) * 100) : 0;
            const upAsk = upBook.asks?.length ? Math.round(parseFloat(upBook.asks[0].price) * 100) : 0;
            const downBid = downBook.bids?.length ? Math.round(parseFloat(downBook.bids[0].price) * 100) : 0;
            const downAsk = downBook.asks?.length ? Math.round(parseFloat(downBook.asks[0].price) * 100) : 0;
            if (upAsk > 0 && downAsk > 0) {
              orderbookRef.current = { upBid, upAsk, downBid, downAsk, isLiveClob: true };
              setOrderbook(orderbookRef.current);
              setWsStatus((s) => ({ ...s, polyClob: true }));
              return;
            }
          }
        } catch {}
      }
      setWsStatus((s) => ({ ...s, polyClob: false }));
    };

    syncPolymarket5mBook();
    const timer = setInterval(syncPolymarket5mBook, 2500);
    return () => clearInterval(timer);
  }, []);

  // ==================== 模块三 & 四：每秒核心循环 (5m周期切换 + 盘口定价 + 翻转评分 + $5实盘模拟) ====================
  useEffect(() => {
    const loop = setInterval(() => {
      const now = Date.now();
      const nowSec = Math.floor(now / 1000);
      const currentWinStart = Math.floor(nowSec / 300) * 300;
      const elapsedSec = nowSec - currentWinStart;
      const remainSec = 300 - elapsedSec;

      const { spot, chainlink } = pricesRef.current;
      if (spot === 0) return;

      // 消除 USDT/USD 固定汇率差，计算对齐后的实时 Chainlink 估算值
      const rawBasis = spot - (chainlink || spot);
      basisWindowRef.current.push(rawBasis);
      if (basisWindowRef.current.length > 180) basisWindowRef.current.shift();
      const meanBasis =
        basisWindowRef.current.reduce((a, b) => a + b, 0) / basisWindowRef.current.length;
      const debiasedSpotAsOracle = spot - meanBasis;

      // 1. 检测是否进入新的 5 分钟盘口周期 (T_0 结算上一盘 + 重置本盘基准价 Strike)
      if (pricesRef.current.windowStartSec !== currentWinStart) {
        const prevStrike = pricesRef.current.strike;
        const settlePrice = chainlink || debiasedSpotAsOracle;

        // 结算上一周期所有未平仓的 $5 模拟订单
        if (pricesRef.current.windowStartSec !== 0 && prevStrike > 0) {
          const actualWinner: 'UP' | 'DOWN' = settlePrice >= prevStrike ? 'UP' : 'DOWN';
          setTradeLedger((prev) =>
            prev.map((tr) => {
              if (tr.status !== 'HOLDING' && tr.status !== 'STAGE1_FREEROLL') return tr;
              const isWin = tr.side === actualWinner;
              const finalSettlementPayout = isWin ? tr.remainingShares * 1.0 : 0;
              const totalPayout = Number((tr.stage1PayoutUsd + finalSettlementPayout).toFixed(2));
              const netPnL = Number((totalPayout - tr.betAmountUsd).toFixed(2));
              if (finalSettlementPayout > 0) {
                setSimVirtualBankroll((b) => Number((b + finalSettlementPayout).toFixed(2)));
              }
              return {
                ...tr,
                settlementPrice: settlePrice,
                finalPayoutUsd: totalPayout,
                netPnL,
                status: isWin
                  ? 'WON_FULL'
                  : tr.stage1Triggered
                  ? 'FREEROLL_EXPIRED'
                  : 'LOSS_STOPPED',
                notes: isWin
                  ? `🎯 绝地翻盘成功！收盘 $${settlePrice.toFixed(2)} 跨越 Strike ($${prevStrike.toFixed(2)})，尾仓按 $1.00 结算！`
                  : tr.stage1Triggered
                  ? `🛡️ 尾盘未过 Strike ($${settlePrice.toFixed(2)})，但已靠第1阶段翻倍抽本净赚 +$${netPnL.toFixed(2)}`
                  : `❌ 未能翻转，收盘 $${settlePrice.toFixed(2)}`,
              };
            })
          );
        }

        // 锁定新周期 Strike 基准价并清空本盘走势图
        const newStrike = chainlink || spot;
        pricesRef.current.windowStartSec = currentWinStart;
        pricesRef.current.strike = newStrike;
        pricesRef.current.windowHigh = spot;
        pricesRef.current.windowLow = spot;
        setStrikePrice(newStrike);
        setChartSeries([]);
      }

      const activeStrike = pricesRef.current.strike || chainlink || spot;

      // 2. 计算 1m ATR 真实波幅
      const klines = klinesRef.current;
      let atr1m = 35; // 默认 $35
      if (klines.length >= 5) {
        const recent = klines.slice(-10);
        atr1m =
          recent.reduce((acc, k) => acc + Math.max(k.high - k.low, 8), 0) / recent.length;
      }

      // 3. 清理超过 45 秒的 Tick 并计算 5s 与 30s 主动买卖失衡比 (TIR)
      const cutoff30s = now - 30000;
      const cutoff5s = now - 5000;
      tradesRef.current = tradesRef.current.filter((t) => t.time >= cutoff30s);

      const calcTIR = (since: number) => {
        let buy = 0;
        let sell = 0;
        for (const t of tradesRef.current) {
          if (t.time >= since) {
            if (t.isBuyerMaker) sell += t.qty;
            else buy += t.qty;
          }
        }
        return buy + sell > 0.001 ? (buy - sell) / (buy + sell) : 0;
      };

      const tir5s = calcTIR(cutoff5s);
      const tir30s = calcTIR(cutoff30s);

      // 4. 计算当前距 Strike 差值与实时二元期权盘口买一/卖一价
      // 使用去偏后的实时有效价格相对于 Strike 的偏离度
      const effectivePrice = chainlink > 0 ? 0.65 * debiasedSpotAsOracle + 0.35 * chainlink : spot;
      const dollarGap = effectivePrice - activeStrike;
      const oracleGap = (chainlink || spot) - activeStrike;
      const timeFactor = Math.sqrt(Math.max(remainSec, 4) / 60);
      const signedZ = dollarGap / (atr1m * 0.85 * timeFactor);

      // 若未连上真实 CLOB 深度，采用基于 Black-Scholes 数字期权 + 订单流偏置的精准盘口定价模型
      if (!orderbookRef.current.isLiveClob) {
        const fairProbUp = normCDF(signedZ + tir5s * 0.18);
        const upMid = Math.max(2, Math.min(98, Math.round(fairProbUp * 100)));
        const downMid = 100 - upMid;
        orderbookRef.current = {
          upBid: Math.max(1, upMid - 1),
          upAsk: Math.min(99, upMid + 1),
          downBid: Math.max(1, downMid - 1),
          downAsk: Math.min(99, downMid + 1),
          isLiveClob: false,
        };
        setOrderbook({ ...orderbookRef.current });
      }

      const { upBid, upAsk, downBid, downAsk } = orderbookRef.current;

      // 5. 追加当前秒的图表轨迹点
      setChartSeries((prev) => {
        const next = [
          ...prev,
          {
            elapsedSec,
            spot: debiasedSpotAsOracle,
            chainlink: chainlink || debiasedSpotAsOracle,
            strike: activeStrike,
            upBid,
            upAsk,
            downBid,
            downAsk,
          },
        ];
        return next.length > 300 ? next.slice(-300) : next;
      });

      // 6. 计算劣势方（价格较低一方）的 ≤10¢ 翻转狙击指标
      const targetSide: 'UP' | 'DOWN' = upAsk <= downAsk ? 'UP' : 'DOWN';
      const targetAskCents = targetSide === 'UP' ? upAsk : downAsk;
      const targetBidCents = targetSide === 'UP' ? upBid : downBid;
      const normalizedGapR = Math.abs(dollarGap) / (atr1m * timeFactor);

      // 极值反弹幅度：若看涨反转(UP)，看当前价相比本盘最低点反弹了多少美元；若看跌反转(DOWN)，看相比最高点回落了多少
      const bounceFromExtreme =
        targetSide === 'UP'
          ? Math.max(0, spot - pricesRef.current.windowLow)
          : Math.max(0, pricesRef.current.windowHigh - spot);

      // 预言机缓冲垫：Chainlink 距离 Strike 比 Spot 距离 Strike 近多少美元
      const oracleCushionAdvantage = Math.max(0, Math.abs(dollarGap) - Math.abs(oracleGap));

      // 计算综合翻转得分 (0 - 100分)
      // (A) 时间与差值可追性得分 (0-30分)：剩余 80s~230s 且 R_gap 在 [0.7, 1.65] 之间最优
      let timeGapScore = 0;
      if (remainSec >= 70 && remainSec <= 240) {
        timeGapScore += 15;
        if (normalizedGapR >= 0.65 && normalizedGapR <= 1.65) timeGapScore += 15;
        else if (normalizedGapR <= 2.0) timeGapScore += 7;
      }

      // (B) 5秒高频订单流逆转吸收得分 (0-35分)：劣势方向突然出现主动买盘/卖盘反扑
      const directionalTIR5s = targetSide === 'UP' ? tir5s : -tir5s;
      const orderFlowReversalScore = Math.max(
        0,
        Math.min(35, Math.round((directionalTIR5s + 0.15) * 55))
      );

      // (C) 极值插针收回得分 (0-20分)：已从盘中极值走出 Pin-bar 反弹
      const bounceRatio = bounceFromExtreme / Math.max(atr1m, 10);
      const wickBounceScore = Math.max(0, Math.min(20, Math.round(bounceRatio * 45)));

      // (D) Chainlink 预言机滞后缓冲垫得分 (0-15分)
      const oracleCushionScore = Math.max(
        0,
        Math.min(15, Math.round((oracleCushionAdvantage / Math.max(atr1m, 10)) * 35))
      );

      const reversalScore = Math.min(
        99,
        timeGapScore + orderFlowReversalScore + wickBounceScore + oracleCushionScore
      );

      // 判断本周期是否已经下过单（每 5m 周期最多狙击 1 次，严格控风控）
      const windowLabel = `${new Date(currentWinStart * 1000).toLocaleTimeString()} - ${new Date(
        (currentWinStart + 300) * 1000
      ).toLocaleTimeString()}`;
      const alreadyTradedThisWindow = tradeLedgerRef.current.some(
        (t) => t.windowLabel === windowLabel
      );

      const canSnipe =
        !alreadyTradedThisWindow &&
        remainSec >= 65 &&
        remainSec <= 245 &&
        targetAskCents >= 2 &&
        targetAskCents <= maxEntryCents &&
        reversalScore >= minReversalScore;

      const triggerReason = `5s订单流反转:${(directionalTIR5s * 100).toFixed(0)}% | 极值收回:$${bounceFromExtreme.toFixed(1)} | 标准化差值R:${normalizedGapR.toFixed(2)}`;

      const metrics: SniperMetrics = {
        remainSec,
        targetSide,
        targetAskCents,
        targetBidCents,
        dollarGap,
        oracleGap,
        atr1m,
        normalizedGapR,
        tir5s,
        tir30s,
        bounceFromExtreme,
        oracleCushionAdvantage,
        reversalScore,
        canSnipe,
        triggerReason,
      };
      setSniperMetrics(metrics);

      // 7. 自动触发 $5.00 狙击建仓
      if (autoSimEnabled && canSnipe) {
        executeFiveDollarSnipe(metrics, windowLabel, activeStrike, spot);
      }

      // 8. 检查持仓中的订单是否达到「第一阶段：2.5倍卖出一半抽回本金（Free-Roll）」条件
      setTradeLedger((prev) =>
        prev.map((tr) => {
          if (tr.status !== 'HOLDING') return tr;
          const currentSideBidCents = tr.side === 'UP' ? upBid : downBid;
          // 当买一价达到建仓成本的 2.5 倍（且至少 >= 18¢）时，平仓 50% 锁定本金与利润！
          if (currentSideBidCents >= Math.max(18, Math.round(tr.entryPriceCents * 2.5))) {
            const halfShares = Number((tr.initialShares / 2).toFixed(2));
            const payoutUsd = Number(((halfShares * currentSideBidCents) / 100).toFixed(2));
            setSimVirtualBankroll((b) => Number((b + payoutUsd).toFixed(2)));
            return {
              ...tr,
              remainingShares: Number((tr.initialShares - halfShares).toFixed(2)),
              stage1Triggered: true,
              stage1PayoutUsd: payoutUsd,
              status: 'STAGE1_FREEROLL',
              notes: `🔥 盘中反弹至 ${currentSideBidCents}¢！已平半仓收回 $${payoutUsd.toFixed(2)}（本金全回+锁利），余下半仓零风险博 $1.00 结算！`,
            };
          }
          return tr;
        })
      );
    }, 1000);

    return () => clearInterval(loop);
  }, [autoSimEnabled, maxEntryCents, minReversalScore]);

  // 执行单笔 $5.00 模拟建仓
  const executeFiveDollarSnipe = (
    m: SniperMetrics,
    windowLabel: string,
    activeStrike: number,
    currentSpot: number
  ) => {
    const betUsd = 5.0;
    const entryCents = Math.max(2, m.targetAskCents);
