            <div className="text-xl font-mono font-bold text-white mt-1">
              ${spotPrice ? spotPrice.toFixed(2) : '---'}
            </div>
            <div
              className={`text-xs font-mono font-semibold mt-1 ${
                (sniperMetrics?.dollarGap || 0) >= 0 ? 'text-emerald-400' : 'text-rose-400'
              }`}
            >
              差值: {(sniperMetrics?.dollarGap || 0) >= 0 ? '+' : ''}
              {sniperMetrics ? sniperMetrics.dollarGap.toFixed(2) : '0.00'} USD
            </div>
          </div>

          <div className="bg-slate-900 border border-emerald-500/30 rounded-xl p-3.5">
            <div className="text-xs text-emerald-300 flex justify-between">
              <span>UP (看涨) 盘口报价</span>
              {orderbook.upAsk <= maxEntryCents && (
                <span className="px-1.5 bg-rose-500 text-white rounded animate-pulse">≤{maxEntryCents}¢!</span>
              )}
            </div>
            <div className="text-xl font-mono font-bold text-emerald-400 mt-1">
              买一 {orderbook.upBid}¢ <span className="text-slate-500 text-sm">/ 卖一 {orderbook.upAsk}¢</span>
            </div>
            <div className="text-xs text-slate-400 mt-1">
              潜在满额赔率: {(100 / Math.max(1, orderbook.upAsk)).toFixed(1)}x 倍
            </div>
          </div>

          <div className="bg-slate-900 border border-rose-500/30 rounded-xl p-3.5">
            <div className="text-xs text-rose-300 flex justify-between">
              <span>DOWN (看跌) 盘口报价</span>
              {orderbook.downAsk <= maxEntryCents && (
                <span className="px-1.5 bg-rose-500 text-white rounded animate-pulse">≤{maxEntryCents}¢!</span>
              )}
            </div>
            <div className="text-xl font-mono font-bold text-rose-400 mt-1">
              买一 {orderbook.downBid}¢ <span className="text-slate-500 text-sm">/ 卖一 {orderbook.downAsk}¢</span>
            </div>
            <div className="text-xs text-slate-400 mt-1">
              潜在满额赔率: {(100 / Math.max(1, orderbook.downAsk)).toFixed(1)}x 倍
            </div>
          </div>

          <div className="bg-indigo-950/50 border border-indigo-500/40 rounded-xl p-3.5 flex flex-col justify-between">
            <div className="flex justify-between text-xs text-indigo-300">
              <span>本盘剩余时间</span>
              <span>
                {sniperMetrics && sniperMetrics.remainSec >= 70 && sniperMetrics.remainSec <= 240
                  ? '🟢 黄金狙击窗'
                  : '⏳ 观察期'}
              </span>
            </div>
            <div className="text-2xl font-mono font-black text-white">
              {sniperMetrics ? Math.floor(sniperMetrics.remainSec / 60) : 0}:
              {String(sniperMetrics ? sniperMetrics.remainSec % 60 : 0).padStart(2, '0')}
            </div>
            <div className="text-xs text-indigo-300">
              模拟资金池: <span className="font-mono font-bold text-white">${simVirtualBankroll.toFixed(2)}</span>
            </div>
          </div>
        </div>

        {/* ==================== 模块二：双轨实时走势图 (BTC价格轨迹 + Polymarket 买一/卖一盘口走势) ==================== */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-2">
            <div className="flex justify-between items-center">
              <h3 className="text-sm font-bold text-white">
                📈 当前盘 BTC 价格走势 (Chainlink vs 币安实时价 vs Strike 基准线)
              </h3>
              <span className="text-xs text-slate-400 font-mono">
                标准化差值 R_gap: {sniperMetrics ? sniperMetrics.normalizedGapR.toFixed(2) : '--'}
              </span>
            </div>
            {renderPriceTrajectorySvg()}
          </div>

          <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-2">
            <div className="flex justify-between items-center">
              <h3 className="text-sm font-bold text-white">
                📊 Polymarket 当前盘涨跌买一/卖一价格走势 (0¢ – 100¢)
              </h3>
              <span className="text-xs text-rose-400 font-mono">
                底部红色阴影 = ≤{maxEntryCents}¢ 狙击触发带
              </span>
            </div>
            {renderOrderbookTrajectorySvg()}
          </div>
        </div>

        {/* ==================== 模块三：≤10¢ 翻转几率雷达与 $5 手动/自动狙击控制台 ==================== */}
        {sniperMetrics && (
          <div className="bg-slate-900 border-2 border-indigo-500/40 rounded-xl p-5">
            <div className="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-4 mb-4">
              <div>
                <h2 className="text-base font-bold text-white flex items-center gap-2">
                  雷达锁定劣势方:{' '}
                  <span
                    className={
                      sniperMetrics.targetSide === 'UP' ? 'text-emerald-400' : 'text-rose-400'
                    }
                  >
                    {sniperMetrics.targetSide} (当前卖一价 {sniperMetrics.targetAskCents}¢ / 买一价{' '}
                    {sniperMetrics.targetBidCents}¢)
                  </span>
                </h2>
                <p className="text-xs text-slate-400 mt-0.5">{sniperMetrics.triggerReason}</p>
              </div>

              {/* 参数调节与手动 $5 狙击按钮 */}
              <div className="flex flex-wrap items-center gap-4 text-xs">
                <label className="flex items-center gap-1.5 text-slate-300">
                  <span>触发价格上限(¢):</span>
                  <input
                    type="number"
                    min={3}
                    max={25}
                    value={maxEntryCents}
                    onChange={(e) => setMaxEntryCents(Number(e.target.value))}
                    className="w-14 bg-slate-950 border border-slate-700 rounded px-2 py-1 font-mono text-amber-400"
                  />
                </label>

                <label className="flex items-center gap-1.5 text-slate-300">
                  <span>最低翻转分:</span>
                  <input
                    type="number"
                    min={35}
                    max={90}
                    value={minReversalScore}
                    onChange={(e) => setMinReversalScore(Number(e.target.value))}
                    className="w-14 bg-slate-950 border border-slate-700 rounded px-2 py-1 font-mono text-indigo-300"
                  />
                </label>

                <label className="flex items-center gap-1.5 text-slate-200 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={autoSimEnabled}
                    onChange={(e) => setAutoSimEnabled(e.target.checked)}
                    className="rounded bg-slate-800"
                  />
                  达标自动以 $5 狙击
                </label>

                <button
                  onClick={() => {
                    const winStart = Math.floor(Date.now() / 1000 / 300) * 300;
                    const label = `${new Date(winStart * 1000).toLocaleTimeString()} - ${new Date(
                      (winStart + 300) * 1000
                    ).toLocaleTimeString()}`;
                    executeFiveDollarSnipe(sniperMetrics, label, strikePrice, spotPrice);
                  }}
                  className="px-3.5 py-2 bg-rose-600 hover:bg-rose-500 font-bold text-white rounded-lg shadow transition"
                >
                  🎯 立即以 $5.00 手动模拟买入 {sniperMetrics.targetSide} ({sniperMetrics.targetAskCents}¢)
                </button>
              </div>
            </div>

            {/* 四维翻转几率评分进度条 */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
              <div className="bg-slate-950 p-3 rounded-lg border border-slate-800">
                <div className="flex justify-between text-slate-400">
                  <span>综合翻转几率评分</span>
                  <span className="font-mono font-bold text-white">
                    {sniperMetrics.reversalScore} / 100
                  </span>
                </div>
                <div className="w-full bg-slate-800 h-2 rounded-full mt-2 overflow-hidden">
                  <div
                    className={`h-full ${
                      sniperMetrics.reversalScore >= minReversalScore
                        ? 'bg-emerald-500'
                        : 'bg-amber-500'
                    }`}
                    style={{ width: `${sniperMetrics.reversalScore}%` }}
                  />
                </div>
              </div>

              <div className="bg-slate-950 p-3 rounded-lg border border-slate-800">
                <span className="text-slate-400 block">5秒订单流脉冲 (TIR_5s)</span>
                <span className="text-base font-mono font-bold text-indigo-300 mt-1 block">
                  {(sniperMetrics.tir5s * 100).toFixed(1)}% (30s: {(sniperMetrics.tir30s * 100).toFixed(1)}%)
                </span>
              </div>

              <div className="bg-slate-950 p-3 rounded-lg border border-slate-800">
                <span className="text-slate-400 block">本盘极值 Pin-bar 反弹幅度</span>
                <span className="text-base font-mono font-bold text-emerald-400 mt-1 block">
                  +${sniperMetrics.bounceFromExtreme.toFixed(2)} USD
                </span>
              </div>

              <div className="bg-slate-950 p-3 rounded-lg border border-slate-800">
                <span className="text-slate-400 block">Chainlink 预言机缓冲垫优势</span>
                <span className="text-base font-mono font-bold text-amber-400 mt-1 block">
                  +${sniperMetrics.oracleCushionAdvantage.toFixed(2)} USD
                </span>
              </div>
            </div>
          </div>
        )}

        {/* ==================== 模块四：$5.00 单元实盘模拟交易记录账本 ==================== */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <div className="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h2 className="text-base font-bold text-white">
                📒 $5.00 单元实盘模拟交易记录 (含盘中 2.5x 半仓抽本 Free-Roll 与结算明细)
              </h2>
              <p className="text-xs text-slate-400 mt-0.5">
                累计交易: <span className="text-white font-bold">{totalTrades}</span> 笔 | 盈利/保本笔数:{' '}
                <span className="text-emerald-400 font-bold">{profitableCount}</span> 笔 | 累计净盈亏 (Net P&L):{' '}
                <span
                  className={`font-mono font-bold ${
                    totalNetPnL >= 0 ? 'text-emerald-400' : 'text-rose-400'
                  }`}
                >
                  {totalNetPnL >= 0 ? '+' : ''}${totalNetPnL.toFixed(2)} USDC
                </span>
              </p>
            </div>

            {tradeLedger.length > 0 && (
              <button
                onClick={() => {
                  setTradeLedger([]);
                  setSimVirtualBankroll(100);
                  localStorage.removeItem('poly_sub10_ledger_v1');
                }}
                className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 rounded-lg"
              >
                🗑️ 清空记录并重置 $100 模拟金
              </button>
            )}
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse text-xs">
              <thead>
                <tr className="border-b border-slate-800 text-slate-400">
                  <th className="py-2.5 px-3">盘口时段 / 建仓时间</th>
                  <th className="py-2.5 px-3">狙击方向</th>
                  <th className="py-2.5 px-3">买入价 / 投入</th>
                  <th className="py-2.5 px-3">购得份额 (剩余)</th>
                  <th className="py-2.5 px-3">Strike / 结算价</th>
                  <th className="py-2.5 px-3">翻转分</th>
                  <th className="py-2.5 px-3">总收回 / 净盈亏</th>
                  <th className="py-2.5 px-3">状态与两段式止盈详情</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/70 font-mono">
                {tradeLedger.length === 0 ? (
                  <tr>
                    <td colSpan={8} className="text-center py-8 text-slate-500 font-sans">
                      暂无狙击记录。当盘中 UP 或 DOWN 跌至 ≤{maxEntryCents}¢ 且翻转评分 ≥{minReversalScore}{' '}
                      时将自动以 $5.00 建仓，或点击上方红色按钮手动测试建仓。
                    </td>
                  </tr>
                ) : (
                  tradeLedger.map((tr) => (
                    <tr key={tr.id} className="hover:bg-slate-950/60">
                      <td className="py-3 px-3">
                        <div className="text-slate-200">{tr.windowLabel}</div>
                        <div className="text-slate-500 text-[11px]">建仓 @ {tr.entryTime}</div>
                      </td>
                      <td className="py-3 px-3">
                        <span
                          className={`px-2 py-0.5 rounded font-bold ${
                            tr.side === 'UP'
                              ? 'bg-emerald-500/20 text-emerald-400'
                              : 'bg-rose-500/20 text-rose-400'
                          }`}
                        >
                          {tr.side}
                        </span>
                      </td>
                      <td className="py-3 px-3">
                        <span className="text-amber-400 font-bold">{tr.entryPriceCents}¢</span> / $
                        {tr.betAmountUsd.toFixed(2)}
                      </td>
                      <td className="py-3 px-3">
                        {tr.initialShares} 份{' '}
                        <span className="text-slate-400">(余 {tr.remainingShares})</span>
                      </td>
                      <td className="py-3 px-3">
                        <div>Strike: ${tr.strikePrice.toFixed(2)}</div>
                        <div className="text-slate-400">
                          结算: {tr.settlementPrice ? `$${tr.settlementPrice.toFixed(2)}` : '进行中...'}
                        </div>
                      </td>
                      <td className="py-3 px-3 text-indigo-300 font-bold">
                        {tr.reversalScoreAtEntry}分
                      </td>
                      <td className="py-3 px-3">
                        <div>收回: ${tr.finalPayoutUsd.toFixed(2)}</div>
                        <div
                          className={`font-bold ${
                            tr.netPnL >= 0 ? 'text-emerald-400' : 'text-rose-400'
                          }`}
                        >
                          {tr.netPnL >= 0 ? '+' : ''}${tr.netPnL.toFixed(2)}
                        </div>
                      </td>
                      <td className="py-3 px-3 font-sans max-w-xs">
                        <span
                          className={`inline-block px-2 py-0.5 rounded text-[11px] font-semibold mb-1 ${
                            tr.status === 'WON_FULL'
                              ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
                              : tr.status === 'STAGE1_FREEROLL' || tr.status === 'FREEROLL_EXPIRED'
                              ? 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40'
                              : tr.status === 'HOLDING'
                              ? 'bg-amber-500/20 text-amber-300'
                              : 'bg-rose-500/20 text-rose-300'
                          }`}
                        >
                          {tr.status === 'WON_FULL'
                            ? '🏆 绝地翻盘大捷 (+10x)'
                            : tr.status === 'STAGE1_FREEROLL'
                            ? '🛡️ 已翻倍抽本 (半仓零风险博弈中)'
                            : tr.status === 'FREEROLL_EXPIRED'
                            ? '✅ 抽本锁利 (尾仓归零仍净赚)'
                            : tr.status === 'HOLDING'
                            ? '⏳ 持仓等待反弹'
                            : '❌ 止损 (-$5.00)'}
                        </span>
                        <div className="text-slate-400 text-[11px] leading-snug">{tr.notes}</div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  );
}