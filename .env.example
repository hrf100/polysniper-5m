# PORT: HTTP listen port.
PORT=3000

# AUTH_PASSWORD: Access password for the web terminal (default: qq111111).
AUTH_PASSWORD="qq111111"

# AUTH_SECRET: Optional extra secret mixed into session signing.
# Changing it (or the password) logs out all sessions.
AUTH_SECRET=""

# DATA_DIR: Where the resident strategy persists ledger/bankroll/settings (default: ./data).
# DATA_DIR="./data"

# DISPLAY_TZ: Time zone for window labels / entry times (default: Asia/Shanghai).
# DISPLAY_TZ="Asia/Shanghai"

# TRUST_PROXY: Express "trust proxy" setting. Default "loopback" (nginx/caddy on same host).
# TRUST_PROXY="loopback"
